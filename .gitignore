# Downloaded third-party corpus data; retain only manifests and code in Git.
resources/mediasum/*.json
resources/mediasum/*.jsonl
resources/mediasum/.download-*

# Local credentials. Keep .env_example tracked as the shareable template.
.env

# Locally built Go CLI executable.
/isc-rag

# Locally compiled capability-limited agent tools.
/bin/

# Raw study completions and validated source quotations derive from MediaSum and
# must remain local under its research-use terms.
/artifacts/

# A legacy local study-artifact directory; transcript-derived material belongs
# under ignored artifacts rather than in the research repository.
/ignored artifacts/
